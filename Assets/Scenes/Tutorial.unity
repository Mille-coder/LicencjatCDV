--- !u!114 &1938038160
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1938038158}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f110c976f6168fc49965662a7d4f676f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueLines:
  - portrait: {fileID: 21300000, guid: a540ff2eec72f44ea9c18faf6bef02f5, type: 3}
    text: Please-! Someone help me!
  - portrait: {fileID: 21300000, guid: 9fa76810c86df4dcf80b14183fbf378d, type: 3}
    text: "Hey-! I\u2019m here!"
  - portrait: {fileID: 21300000, guid: 9fa76810c86df4dcf80b14183fbf378d, type: 3}
    text: "\u2026I\u2019ve got you."
  - portrait: {fileID: 21300000, guid: a540ff2eec72f44ea9c18faf6bef02f5, type: 3}
    text: "You came\u2026"
  - portrait: {fileID: 21300000, guid: a540ff2eec72f44ea9c18faf6bef02f5, type: 3}
    text: I thought I was going to-
  - portrait: {fileID: 21300000, guid: fc126626ed9dd4bf6b53ac4483ef1ae0, type: 3}
    text: ...
  - portrait: {fileID: 21300000, guid: 9fa76810c86df4dcf80b14183fbf378d, type: 3}
    text: "\u2026What?"
  - portrait: {fileID: 21300000, guid: a540ff2eec72f44ea9c18faf6bef02f5, type: 3}
    text: "Please\u2026 help me."
  - portrait: {fileID: 21300000, guid: a07c21a639560e3479d2292177e8713d, type: 3}
    text: "Jay! We don\u2019t have time!"
  - portrait: {fileID: 21300000, guid: a07c21a639560e3479d2292177e8713d, type: 3}
    text: "That structure\u2019s unstable. Move!"
  - portrait: {fileID: 21300000, guid: 9fa76810c86df4dcf80b14183fbf378d, type: 3}
    text: Stay close.
  - portrait: {fileID: 21300000, guid: 9fa76810c86df4dcf80b14183fbf378d, type: 3}
    text: "We\u2019re getting out."
  dialogueManager: {fileID: 1696210399}
