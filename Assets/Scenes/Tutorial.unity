  m_GameObject: {fileID: 1551559742}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f548d263d6657fd4991b18a990f74054, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  popupPanel: {fileID: 284311961}
  popupText: {fileID: 433604173}
  portraitImage: {fileID: 1709105867}
  typingSpeed: 0.04
  autoHideDelay: 2
  popups:
  - triggerCollider: {fileID: 930203692}
    text: "I\u2019ll need that axe."
    portrait: {fileID: 2105737870, guid: 4adce8e67545d4c6eb1e95508ecdf6be, type: 3}
  - triggerCollider: {fileID: 1091095046}
    text: I should be able to jump over that branch.
    portrait: {fileID: 2105737870, guid: 4adce8e67545d4c6eb1e95508ecdf6be, type: 3}
  - triggerCollider: {fileID: 623594296}
    text: "The tree\u2019s damaged by the fire\u2026 the axe should do the job."
    portrait: {fileID: 2105737870, guid: 4adce8e67545d4c6eb1e95508ecdf6be, type: 3}
  - triggerCollider: {fileID: 642274807}
    text: "Wouldn\u2019t be the first bush I\u2019ve had to get past."
    portrait: {fileID: 2105737870, guid: 4adce8e67545d4c6eb1e95508ecdf6be, type: 3}
  - triggerCollider: {fileID: 1210565916}
    text: "Front door\u2019s blocked by fire. Roof it is."
    portrait: {fileID: 2105737870, guid: 4adce8e67545d4c6eb1e95508ecdf6be, type: 3}
  - triggerCollider: {fileID: 1209701828}
    text: "That dumpster should be easy to move\u2026 and it\u2019ll get me higher."
    portrait: {fileID: 2105737870, guid: 4adce8e67545d4c6eb1e95508ecdf6be, type: 3}
