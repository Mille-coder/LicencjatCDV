    - target: {fileID: 1327806454121411588, guid: aaa41d69568528649b66b3d79e147291, type: 3}
      propertyPath: dialogueLines.Array.data[0].text
      value: "You're Here\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 1327806454121411588, guid: aaa41d69568528649b66b3d79e147291, type: 3}
      propertyPath: dialogueLines.Array.data[1].text
      value: Too late.
      objectReference: {fileID: 0}
    - target: {fileID: 1327806454121411588, guid: aaa41d69568528649b66b3d79e147291, type: 3}
      propertyPath: dialogueLines.Array.data[2].text
      value: It's not too late.
      objectReference: {fileID: 0}
    - target: {fileID: 1327806454121411588, guid: aaa41d69568528649b66b3d79e147291, type: 3}
      propertyPath: dialogueLines.Array.data[3].text
      value: Reconstruction incomplete.
      objectReference: {fileID: 0}
    - target: {fileID: 1327806454121411588, guid: aaa41d69568528649b66b3d79e147291, type: 3}
      propertyPath: dialogueLines.Array.data[4].text
      value: I didn't need a hero.
      objectReference: {fileID: 0}
    - target: {fileID: 1327806454121411588, guid: aaa41d69568528649b66b3d79e147291, type: 3}
      propertyPath: dialogueLines.Array.data[5].text
      value: ...
      objectReference: {fileID: 0}
    - target: {fileID: 1327806454121411588, guid: aaa41d69568528649b66b3d79e147291, type: 3}
      propertyPath: dialogueLines.Array.data[6].text
      value: I needed you.
      objectReference: {fileID: 0}
    - target: {fileID: 1327806454121411588, guid: aaa41d69568528649b66b3d79e147291, type: 3}
      propertyPath: dialogueLines.Array.data[7].text
      value: ...
      objectReference: {fileID: 0}
    - target: {fileID: 1327806454121411588, guid: aaa41d69568528649b66b3d79e147291, type: 3}
      propertyPath: dialogueLines.Array.data[8].text
      value: "To everyone else, you were a hero\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 1327806454121411588, guid: aaa41d69568528649b66b3d79e147291, type: 3}
      propertyPath: dialogueLines.Array.data[9].text
      value: ...but to me-
      objectReference: {fileID: 0}
    - target: {fileID: 1327806454121411588, guid: aaa41d69568528649b66b3d79e147291, type: 3}
      propertyPath: dialogueLines.Array.data[10].text
      value: '"Reconstruction error."'
      objectReference: {fileID: 0}
    - target: {fileID: 1327806454121411588, guid: aaa41d69568528649b66b3d79e147291, type: 3}
      propertyPath: dialogueLines.Array.data[11].text
      value: I tried...
      objectReference: {fileID: 0}
